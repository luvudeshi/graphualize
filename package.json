{
  "name": "graphualize",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "build:single": "vite build --config vite.config.singlefile.ts && node scripts/inline.mjs",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json --noEmit",
    "lint": "oxlint src e2e api",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verify": "npm run lint && npm run build && npm run test && npm run verify:auth",
    "setup:auth": "node scripts/setup-supabase.mjs",
    "verify:auth": "node scripts/verify-auth.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.4",
    "cytoscape": "^3.34.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "jsdom": "^30.0.1",
    "oxlint": "^1.79.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "description": "An interactive graph theory workbench. Draw graphs. Understand them.",
  "license": "MIT"
}
